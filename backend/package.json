{
  "name": "tattoo-agent-backend",
  "version": "1.0.0",
  "description": "Backend API para TattooAgent",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "server": "node --watch index.js",
    "client": "browser-sync start --proxy http://localhost:4000 --files ../frontend/**/*.html ../frontend/**/*.css ../frontend/**/*.js",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
